# === General rules ===
# Always store text files in LF (universal for Linux, Docker, CI/CD)
* text=auto eol=lf

# === Source code and configuration ===
*.java       text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.properties text eol=lf
*.gradle     text eol=lf
*.md         text eol=lf
Dockerfile   text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf
.gitignore   text eol=lf

# === Scripts (important for Unix/Docker) ===
*.sh         text eol=lf
*.bash       text eol=lf

# === Windows-specific scripts (keep CRLF) ===
*.bat        text eol=crlf
*.cmd        text eol=crlf

# === Binary files (Git should not modify line endings) ===
*.jar        binary
*.war        binary
*.zip        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.class      binary
.idea/**     binary
